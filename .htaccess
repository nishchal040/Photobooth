<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Disable MultiViews to avoid conflicts with mod_rewrite
    Options -MultiViews

    # 1. Redirect /index.html to root /
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index\.html[\s?] [NC]
    RewriteRule ^index\.html$ / [R=301,L]

    # 2. Redirect /path/index.html to /path/
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+)/index\.html[\s?] [NC]
    RewriteRule ^(.+)/index\.html$ /$1/ [R=301,L]

    # 3. Externally redirect any request with .html extension to clean URL (301 Permanent Redirect)
    # Using %{THE_REQUEST} ensures internal rewrites don't trigger an infinite redirect loop
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+?)\.html[\s?] [NC]
    RewriteRule ^(.+?)\.html$ /$1 [R=301,L]

    # 4. Internally rewrite clean URLs back to their corresponding .html files
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.*)$ $1.html [NC,L]
</IfModule>
